{
  "JwtSettings": {
    "Key": "",
    "Issuer": "https://localhost:5001",
    "Audience": "https://localhost:5001",
    "AccessTokenExpiration": 15,
    "RefreshTokenExpiration": 7
  },

  "ConnectionStrings": {
